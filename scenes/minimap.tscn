[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/ui/minimap_view.gd" id="1"]
[ext_resource type="Script" path="res://scripts/gameplay/minimap_camera.gd" id="2"]
[ext_resource type="Script" path="res://scripts/ui/minimap_markers.gd" id="3"]

; Ambiente próprio da câmera: fundo "claro" (transparente no SubViewport) + a mesma luz ambiente de main.tscn.
[sub_resource type="Environment" id="env"]
ambient_light_source = 2
ambient_light_color = Color(0.7, 0.75, 0.85, 1)
ambient_light_energy = 0.6

; DD-185: disco de "espaço" atrás do planeta (2D, não depende do SubViewport 3D): o minimapa e as marcas dos jogadores
; aparecem mesmo que a textura 3D falhe (celulares). 0,95 = o quanto o planeta preenche a janela (planet_fill_factor).
[sub_resource type="StyleBoxFlat" id="disc"]
bg_color = Color(0.04, 0.07, 0.15, 0.6)
border_width_left = 2
border_width_top = 2
border_width_right = 2
border_width_bottom = 2
border_color = Color(0.62, 0.78, 1, 0.55)
corner_radius_top_left = 400
corner_radius_top_right = 400
corner_radius_bottom_right = 400
corner_radius_bottom_left = 400

[node name="Minimap" type="TextureRect"]
mouse_filter = 0
expand_mode = 1
stretch_mode = 0
script = ExtResource("1")

[node name="Backdrop" type="Panel" parent="."]
show_behind_parent = true
layout_mode = 1
anchor_left = 0.025
anchor_top = 0.025
anchor_right = 0.975
anchor_bottom = 0.975
mouse_filter = 2
theme_override_styles/panel = SubResource("disc")

[node name="SubViewport" type="SubViewport" parent="."]
transparent_bg = true
gui_disable_input = true
size = Vector2i(400, 400)
render_target_update_mode = 1

[node name="MinimapCamera" type="Camera3D" parent="SubViewport"]
environment = SubResource("env")
fov = 30.0
near = 50.0
far = 1500.0
script = ExtResource("2")

[node name="Markers" type="Control" parent="."]
script = ExtResource("3")
